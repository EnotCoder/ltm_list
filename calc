#!/usr/bin/env python3
import sys
import os
import tty
import termios
import operator

BUTTONS = {
     1: "1",  2: "2",  3: "3",  4: "*",
     5: "4",  6: "5",  7: "6",  8: "/",
     9: "7", 10: "8", 11: "9", 12: "+",
    13: "x", 14: "0", 15: "=", 16: "-",
}

MAX_LEN = 9

expr = ""
chose_mode = False
cursor = 1
mode_idx = 0


def getch():
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        ch = sys.stdin.read(1)
        if ch == "\x1b":
            seq = ch + sys.stdin.read(2)
            return seq
        return ch
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def eval_expr(expr: str) -> str:
    ops = {
        "+": operator.add, "-": operator.sub,
        "*": operator.mul, "/": operator.truediv,
    }
    tokens = []
    num = ""
    for ch in expr:
        if ch.isdigit() or ch == ".":
            num += ch
        else:
            if num:
                tokens.append(("num", float(num)))
                num = ""
            if ch in ops:
                tokens.append(("op", ch))
    if num:
        tokens.append(("num", float(num)))

    if not tokens:
        return "0"

    for op_char in ("*", "/"):
        i = 1
        while i < len(tokens):
            if tokens[i] == ("op", op_char):
                a = tokens[i - 1][1]
                b = tokens[i + 1][1]
                if op_char == "/" and b == 0:
                    return "Error"
                val = ops[op_char](a, b)
                tokens[i - 1 : i + 2] = [("num", val)]
            else:
                i += 1

    result = tokens[0][1]
    for i in range(1, len(tokens), 2):
        if tokens[i][0] == "op":
            b = tokens[i + 1][1]
            if tokens[i][1] == "+":
                result += b
            elif tokens[i][1] == "-":
                result -= b

    if result == int(result):
        return str(int(result))
    return str(result)


def draw():
    os.system("clear" if os.name == "posix" else "cls")
    print(" ================")
    pad = MAX_LEN - len(expr)
    print(f" |{expr}{' ' * pad}|V:03|")
    print(" ================")
    for row in range(4):
        print(" | ", end="")
        for col in range(4):
            num = col + 1 + row * 4
            ch = BUTTONS[num]
            if num == cursor:
                print(f"\033[31m{ch}\033[0m ", end="")
            else:
                print(f"{ch} ", end="")
        mode_labels = {0: "calc", 1: "exit"}
        label = mode_labels.get(row, "    ")
        if row == mode_idx:
            print(f"|\033[31m{label}\033[0m|")
        else:
            print(f"|{label}|")
    print(" ================")


# ====== Input calc ======
EXIT = "\x03"    # Ctrl+C
EXIT_MODE = "q"  # Q
ENTER = "\r"     # Enter

UP = "\x1b[A"    # up
DOWN = "\x1b[B"  # down
RIGHT = "\x1b[C" # right
LEFT = "\x1b[D"  # left

def input_calc() -> str:
    global expr, cursor, chose_mode

    key = getch()

    if key == EXIT:
        return "exit"

    if key == UP:
        cursor = max(1, cursor - 4)
    elif key == DOWN:
        cursor = min(16, cursor + 4)
    elif key == RIGHT:
        cursor = min(16, cursor + 1)
    elif key == LEFT:
        cursor = max(1, cursor - 1)

    elif key == ENTER:
        ch = BUTTONS[cursor]
        if ch == "x":
            expr = ""
        elif ch in ("*", "/", "+", "-"):
            if len(expr) == 0 or len(expr) >= 8:
                pass
            elif expr and expr[0][-1] in ("*", "/", "+", "-"):
                pass
            else:
                expr += ch
        elif ch == "=":
            expr = eval_expr(expr)
        else:
            if len(expr) < MAX_LEN - 1:
                expr += ch

    elif key == EXIT_MODE:
        return "mode"

    return ""

def input_exit() -> str:
    return "exit"

def input_mode() -> str:
    global mode_idx, chose_mode

    key = getch()
    if key == EXIT:
        return "exit"

    if key == UP:
        mode_idx = max(0, mode_idx - 1)
    elif key == DOWN:
        mode_idx = min(1, mode_idx + 1)

    if key == ENTER:
        chose_mode = False

    return ""


def main():
    global mode_idx, chose_mode

    while True:
        draw()

        if chose_mode == False:
            match mode_idx:
                case 0:
                    result = input_calc()
                case 1:
                    result = input_exit()
        else:
            result = input_mode()

        match result:
            case "exit":
                break
            case "mode":
                chose_mode = True


if __name__ == "__main__":
    main()
