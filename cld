#!/usr/bin/env python3
import os
import shutil
import sys
from pathlib import Path

version = 1.0


def human_size(num: int) -> str:
    size = float(num)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if size < 1024 or unit == "TB":
            return f"{size:.0f} {unit}" if unit == "B" else f"{size:.1f} {unit}"
        size /= 1024
    return f"{size:.1f} TB"


def xdg_dir(key: str, fallback: str) -> Path:
    """Finds the real directory name in user-dirs.dirs (for localized names)."""
    config = Path.home() / ".config" / "user-dirs.dirs"
    if config.is_file():
        try:
            for line in config.read_text(encoding="utf-8", errors="ignore").splitlines():
                line = line.strip()
                if not line.startswith("XDG_") or "=" not in line:
                    continue
                name, value = line.split("=", 1)
                if name == f"XDG_{key.upper()}_DIR" and value.startswith('"$HOME/'):
                    return Path.home() / value[7:].rstrip('"')
        except OSError:
            pass
    return Path.home() / fallback


def find_screenshots() -> Path | None:
    candidates = [
        xdg_dir("pictures", "Pictures") / "Screenshots",
        xdg_dir("pictures", "Pictures") / "Screenshots",
        Path.home() / "Pictures" / "Screenshots",
    ]
    for path in candidates:
        if path.is_dir():
            return path
    return None


def collect(directory: Path) -> list[Path]:
    """All files inside the directory, recursively."""
    files: list[Path] = []
    for root, dirs, names in os.walk(directory):
        dirs.sort()
        for name in sorted(names):
            files.append(Path(root) / name)
    return files


def dir_size(files: list[Path]) -> int:
    total = 0
    for path in files:
        try:
            total += path.stat().st_size
        except OSError:
            pass
    return total


def remove_file(path: Path) -> bool:
    try:
        if path.is_dir() and not path.is_symlink():
            shutil.rmtree(path)
        else:
            path.unlink()
        return True
    except OSError:
        return False


def ask_confirm(prompt: str) -> bool:
    try:
        answer = input(prompt).strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return answer in ("y", "yes")


def main():
    args = sys.argv[1:]

    if args and args[0] in ("-v", "--version"):
        print(version)
        sys.exit(0)

    assume_yes = False
    dry_run = False
    keep_dirs = True

    for arg in args:
        if arg in ("-y", "--yes"):
            assume_yes = True
        elif arg in ("-n", "--dry-run"):
            dry_run = True
        elif arg in ("--purge-dirs",):
            keep_dirs = False
        elif arg in ("-h", "--help"):
            print("Usage:")
            print("  cld                        # delete screenshots and files from ~/Downloads")
            print("  cld -n                     # only show what will be deleted")
            print("  cld -y                     # without confirmation")
            print("  cld --purge-dirs           # delete empty subdirectories")
            sys.exit(0)
        else:
            print(f"Unknown argument: {arg}", file=sys.stderr)
            sys.exit(1)

    targets: list[tuple[str, Path]] = []

    screenshots = find_screenshots()
    if screenshots is None:
        print("Screenshots directory not found, skipping", file=sys.stderr)
    else:
        targets.append(("Screenshots", screenshots))

    downloads = xdg_dir("download", "Downloads")
    if downloads.is_dir():
        targets.append(("Downloads", downloads))
    else:
        print(f"Directory not found, skipping: {downloads}", file=sys.stderr)

    if not targets:
        print("Nothing to delete.")
        sys.exit(0)

    print()
    plan: list[tuple[str, list[Path]]] = []
    for title, directory in targets:
        files = collect(directory)
        plan.append((title, files))
        print(f"{title}: {directory}")
        print(f"  files: {len(files)}   size: {human_size(dir_size(files))}")

    total_files = sum(len(files) for _, files in plan)
    total_size = sum(dir_size(files) for _, files in plan)
    print()
    print(f"Total to delete: {total_files} file(s), {human_size(total_size)}")

    if dry_run:
        print()
        for title, files in plan:
            for path in files:
                print(f"  {title}: {path}")
        print("Nothing deleted (--dry-run).")
        sys.exit(0)

    print()
    if not assume_yes and not ask_confirm("Delete permanently? (y/N): "):
        print("Cancelled.")
        sys.exit(0)

    print()
    for (title, files), (_, directory) in zip(plan, targets):
        failed = 0
        for path in files:
            if not remove_file(path):
                failed += 1
                print(f"  failed: {path}", file=sys.stderr)

        removed_dirs = 0
        if not keep_dirs:
            for root, dirs, names in os.walk(directory, topdown=False):
                for name in dirs:
                    try:
                        os.rmdir(Path(root) / name)
                        removed_dirs += 1
                    except OSError:
                        pass

        line = f"{title}: deleted {len(files) - failed} of {len(files)}"
        if removed_dirs:
            line += f", empty folders: {removed_dirs}"
        print(line)

    print("Done, freed:", human_size(total_size))


if __name__ == "__main__":
    main()
