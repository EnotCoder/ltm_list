#!/usr/bin/env python3
import os
import sys

version = "1.2.1"
logo = "DINS <--"

def print_welcome_page():
    print(logo)
    print("Version: ", version)

def print_code_start(code: str, path: str, line: str):
    code_line = f"|{code} {path}"
    num_space = (len(line) - len(code_line)) - 3
    print(code_line, " " * num_space, "|")

def print_file_found(path: str):
    line = f"| file is - {path} |"

    print("-" * len(line))
    print(line)
    print("-" * len(line))

    print_code_start("nano", path, line)
    print_code_start("nvim", path, line)
    print_code_start("code", path, line)
    print_code_start("subl", path, line)

    print("-" * len(line))


def print_file_not_found():
    print("File not found")
    print(":(")


def search(filename: str, start_path: str = ".") -> str | None:
    try:
        entries = os.listdir(start_path)
    except PermissionError:
        return None
    except OSError:
        return None

    for entry in entries:
        fullpath = os.path.join(start_path, entry)

        if os.path.isfile(fullpath):
            if entry == filename:
                return fullpath
        elif os.path.isdir(fullpath):
            result = search(filename, fullpath)
            if result:
                return result

    return None


def main():
    if len(sys.argv) > 2:
        print("Sorry, You have too many arguments\n:(")
        sys.exit(1)
    elif len(sys.argv) < 2:
        print_welcome_page()
        sys.exit()

    filename = sys.argv[1]

    found = search(filename)
    if found is None:
        print_file_not_found()
        sys.exit(1)

    print_file_found(found)


if __name__ == "__main__":
    main()
