#!/usr/bin/env python3
import sys
import os
from PIL import Image

version = "1.3.1"
logo = "## IMGsh ##"

FORMATS = {
    ".jpg": "JPEG", ".jpeg": "JPEG", ".png": "PNG",
    ".webp": "WEBP", ".bmp": "BMP", ".gif": "GIF",
    ".tiff": "TIFF", ".ico": "ICO",
}

def which_ext(path: str) -> str:
    return os.path.splitext(path)[1].lower()


def to_grayscale(img: Image.Image) -> Image.Image:
    return img.convert("L")


def resize(img: Image.Image, width: int, height: int) -> Image.Image:
    return img.resize((width, height), Image.LANCZOS)


def main():
    if len(sys.argv) == 1:
        print(logo)
        print("Version:", version)
        return
    elif len(sys.argv) == 2:
        print("Usage -> imgsh <source_file> <output_file> --bw/ --r")
        sys.exit(1)

    src = sys.argv[1]
    dst = sys.argv[2]
    flags = sys.argv[3:]

    if not os.path.isfile(src):
        print(f"File not found: {src}", file=sys.stderr)
        sys.exit(1)

    ext_in = which_ext(src)
    ext_out = which_ext(dst)

    if ext_out not in FORMATS:
        print(f"Unsupported format: {ext_out}", file=sys.stderr)
        sys.exit(1)

    img = Image.open(src)

    do_bw = "--bw" in flags
    do_resize = None
    for f in flags:
        if f.startswith("--r="):
            do_resize = f.split("=", 1)[1]
        elif f == "--r":
            idx = flags.index(f)
            if idx + 1 < len(flags):
                do_resize = flags[idx + 1]

    if do_bw:
        img = to_grayscale(img)
        if ext_out in (".jpg", ".jpeg") and img.mode == "L":
            pass

    if do_resize:
        try:
            w, h = map(int, do_resize.lower().split("x"))
        except ValueError:
            print("Invalid size format. Use WxH, e.g., 512x512", file=sys.stderr)
            sys.exit(1)
        img = resize(img, w, h)

    if do_bw and img.mode == "L" and ext_out in (".jpg", ".jpeg"):
        img = img.convert("RGB")
    img.save(dst, format=FORMATS[ext_out])

    print(f"Done: {src} -> {dst}")


if __name__ == "__main__":
    main()
