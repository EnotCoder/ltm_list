#!/usr/bin/env python3
import argparse
from pathlib import Path

import qrcode
from PIL import Image
from qrcode.exceptions import DataOverflowError


def main():
    parser = argparse.ArgumentParser(
        description="Print a QR code in the terminal using double block characters ██."
    )
    parser.add_argument(
        "url",
        nargs="?",
        help="URL to encode as a QR code.",
    )
    parser.add_argument(
        "--invert",
        action="store_true",
        help="Swap filled blocks and spaces.",
    )
    parser.add_argument(
        "-i",
        "--image",
        action="store_true",
        help="Save the QR code as a 400x400 PNG image in ~/Downloads.",
    )
    args = parser.parse_args()

    url = args.url
    if url is None:
        url = input("Enter URL: ")

    url = url.strip()

    if not url:
        parser.error("URL must not be empty.")

    qr = qrcode.QRCode(border=4)
    qr.add_data(url)

    try:
        qr.make(fit=True)
    except DataOverflowError:
        parser.error("URL is too long for a single QR code.")

    if args.image:
        downloads = Path.home() / "Downloads"
        downloads.mkdir(parents=True, exist_ok=True)
        output_path = downloads / "qrcode.png"

        image = qr.make_image(fill_color="black", back_color="white")
        pil_image = image.get_image() if hasattr(image, "get_image") else image
        pil_image = pil_image.resize((400, 400), Image.NEAREST)
        pil_image.save(output_path)

        print(f"QR code image saved: {output_path}")
        return

    filled, empty = ("  ", "██") if args.invert else ("██", "  ")

    print()
    for row in qr.get_matrix():
        print("".join(filled if cell else empty for cell in row))

    print(f"\nURL: {url}")


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, EOFError):
        print("\nCancelled.")
